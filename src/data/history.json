  "moments": [
    { "year": 1950, "title": "The championship is born", "text": "Giuseppe Farina wins the first world championship race at Silverstone on 13 May, in front of King George VI." },
    { "year": 1957, "title": "Fangio's masterpiece", "text": "At the Nürburgring, Fangio smashes the lap record again and again to hunt down the Ferraris and clinch his fifth title." },
    { "year": 1976, "title": "Lauda's return", "text": "Niki Lauda survives a fiery crash at the Nürburgring and races again six weeks later. James Hunt takes the title by one point." },
    { "year": 1988, "title": "McLaren's near-perfect season", "text": "Senna and Prost win 15 of 16 races for McLaren-Honda, starting one of the sport's fiercest rivalries." },
    { "year": 1994, "title": "Imola and the safety revolution", "text": "The deaths of Roland Ratzenberger and Ayrton Senna lead to sweeping safety reforms that have saved countless lives since." },
    { "year": 2000, "title": "Ferrari's drought ends", "text": "Michael Schumacher wins Ferrari's first drivers' title in 21 years, starting five straight championships." },
    { "year": 2009, "title": "The Brawn fairytale", "text": "Rescued from Honda's exit, Brawn GP wins both championships in its only season." },
    { "year": 2014, "title": "The hybrid era", "text": "1.6-litre V6 turbo-hybrid engines arrive, and Mercedes begins an unprecedented run of eight constructors' titles." },
    { "year": 2018, "title": "The halo", "text": "The titanium cockpit protection device becomes mandatory. It has since been credited with saving several drivers." },
    { "year": 2021, "title": "Last-lap decider", "text": "Verstappen and Hamilton arrive in Abu Dhabi level on points. Verstappen passes Hamilton on the final lap to win his first title." },
    { "year": 2022, "title": "Ground effect returns", "text": "A radical aerodynamic reset brings back underfloor downforce to help cars follow each other closely." },
    { "year": 2025, "title": "Norris crowned", "text": "Lando Norris wins his first title by two points over Verstappen, with teammate Piastri also in the fight until the final race." },
    { "year": 2026, "title": "A new era", "text": "All-new cars and power units with close to 50/50 combustion and electric power, fully sustainable fuel and active aero. Cadillac joins as the 11th team." }
